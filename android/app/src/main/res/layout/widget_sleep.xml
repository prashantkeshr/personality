<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sleep_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_sleep_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        android:id="@+id/sleep_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_on_dark_secondary"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/sleep_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textColor="@color/widget_on_dark"
        android:textSize="22sp" />
    <TextView
        android:id="@+id/sleep_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_sleep_accent"
        android:textSize="12sp" />
    <ImageView
        android:id="@+id/sleep_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />
</LinearLayout>
