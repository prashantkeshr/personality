<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/snap_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_snapshot_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        android:id="@+id/snap_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textColor="@color/widget_snapshot_accent"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/snap_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textColor="@color/widget_snapshot_text"
        android:textSize="18sp" />
    <TextView
        android:id="@+id/snap_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_snapshot_text"
        android:textSize="12sp" />
    <LinearLayout
        android:id="@+id/snap_ex_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">
    <TextView
        android:id="@+id/snap_ex_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_snapshot_accent"
        android:textSize="11sp" />
    <TextView
        android:id="@+id/snap_ex"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textColor="@color/widget_snapshot_text"
        android:textSize="15sp" />
    <TextView
        android:id="@+id/snap_ex_reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_snapshot_text"
        android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
