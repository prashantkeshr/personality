<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/water_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_water_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">
    <ImageView
        android:id="@+id/water_bottle"
        android:layout_width="54dp"
        android:layout_height="96dp"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">
    <TextView
        android:id="@+id/water_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_water_outline"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/water_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textColor="@color/widget_water_text"
        android:textSize="20sp" />
    <TextView
        android:id="@+id/water_percent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_water_outline"
        android:textSize="12sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/water_glass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_water_button"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/water_bottle_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_water_button"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
